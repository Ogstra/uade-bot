# UADE_USERNAME: your own real UADE portal username — the same one you'd type
# into the original Tampermonkey script's Basic Auth prompt.
# Used only for local, manual verification of the search engine during this
# phase — never committed. (.env / .env.* are already excluded in .gitignore.)
UADE_USERNAME=

# UADE_PASSWORD: your own real UADE portal password.
# Store it only in a local .env, never in code, never share it in chat/logs.
UADE_PASSWORD=


UADE_START_URL=

# CREDENTIALS_MASTER_KEY: the single master key every user's per-account
# encryption key is derived from (D-13). Generate once locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the resulting 64-character hex string below. Never share it in
# chat/logs/commits.
CREDENTIALS_MASTER_KEY=

# DATABASE_PATH: where the SQLite database file lives on disk. Optional --
# defaults to ./data/uade-bot.db if left blank.
DATABASE_PATH=

# DISCORD_BOT_TOKEN: token del bot creado en Discord Developer Portal.
# Guardalo solo en .env local o en secretos del deploy; no lo pegues en logs,
# commits ni chats.
DISCORD_BOT_TOKEN=

# DISCORD_CLIENT_ID: Application ID del bot de Discord.
# Se usa para registrar slash commands en el servidor autorizado.
DISCORD_CLIENT_ID=

# DISCORD_GUILD_ID: ID del unico servidor de Discord autorizado.
# Los comandos se registran y responden solo en este servidor.
DISCORD_GUILD_ID=

# DASHBOARD_ENABLED: el panel web es opt-in y queda deshabilitado por default.
# Usa solamente "true" para habilitarlo; cualquier otro valor es invalido.
DASHBOARD_ENABLED=false

# DASHBOARD_PORT: puerto HTTP del panel. Opcional; el default es 3000.
DASHBOARD_PORT=3000

# DASHBOARD_USERNAME / DASHBOARD_PASSWORD: admin/admin son defaults exclusivos
# para desarrollo. En operacion cambialos por valores propios. Si siguen en el
# default el proceso emite solo un warning seguro: nunca bloquea el arranque ni
# imprime las credenciales configuradas (D-03).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin

# DASHBOARD_SESSION_SECRET: opcional, minimo 32 caracteres si se configura.
# Si falta, el futuro servidor genera un valor aleatorio solo para ese proceso,
# por lo que las sesiones se invalidan al reiniciar. Nunca pegues secretos reales
# en este archivo versionado; configuralos solamente en el .env local/deploy.
DASHBOARD_SESSION_SECRET=
