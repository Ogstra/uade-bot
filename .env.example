# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Tu ID de usuario de Discord: unica identidad que puede usar /superadmin-agregar y /superadmin-eliminar.
UADE_SUPER_ADMIN_ID=

# --- Cifrado de credenciales ---
# 64 caracteres hex: openssl rand -hex 32
CREDENTIALS_MASTER_KEY=

# --- Dashboard web ---
DASHBOARD_ADDR=:3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# openssl rand -hex 32
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-bytes

# --- Runtime ---
UADE_DB_PATH=data/uade.db
UADE_POLL_INTERVAL_SECONDS=30
# active = el bot busca y notifica. shadow = solo lectura, sin Discord (usado durante la migracion).
UADE_RUNTIME_MODE=active
# Portal SSO de UADE (vacio = default del codigo).
UADE_SSO_PORTAL_URL=

# --- Interlock de migracion ---
# Un deploy nuevo es standalone: no hay implementacion Node contra la cual comparar,
# asi que estas dos van en true y las variables SHADOW_* no aplican.
UADE_CUTOVER_ENABLED=true
UADE_STANDALONE=true

# --- Inicio de sesion con Microsoft por codigo (opcional) ---
# Cada usuario entra con su propia cuenta desde /microsoft, sin dar su
# contrasena. Las tres primeras van juntas; si falta una, la funcion queda
# apagada y se avisa en el log.
# ENTRA_TENANT_ID=
# Raiz del recurso, sin path: https://graph.microsoft.com o https://TENANT.sharepoint.com
# ENTRA_RESOURCE=
# Cifra los refresh tokens en reposo. Minimo 32 caracteres: openssl rand -hex 32
# ENTRA_TOKEN_SECRET=
# App propia registrada en Entra ID como public client. Vacio = cliente publico
# de Microsoft Office, que el tenant puede bloquear con Conditional Access.
# ENTRA_CLIENT_ID=
# ENTRA_DIR=data/entra
# ENTRA_VALIDATE_URL=
