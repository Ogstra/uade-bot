UADE_DB_PATH=data/uade.db
UADE_RUNTIME_MODE=shadow
UADE_POLL_INTERVAL_SECONDS=30
DASHBOARD_ADDR=:3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-bytes
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# DISCORD_PUBLIC_KEY ya no es necesaria: el transporte Gateway no requiere verificar firmas Ed25519 de un endpoint HTTP publico (D-19..D-21).
# ID de Discord del super-admin: unica identidad que puede usar /superadmin-agregar y /superadmin-eliminar.
UADE_SUPER_ADMIN_ID=
# Portal SSO de UADE usado para vincular cuentas (dejar vacio para el default del codigo).
UADE_SSO_PORTAL_URL=
# Clave maestra (hex, 32 bytes) para cifrar credenciales en reposo: openssl rand -hex 32
CREDENTIALS_MASTER_KEY=
UADE_CUTOVER_ENABLED=false
SHADOW_REPORT_PATH=data/shadow-report.json
SHADOW_MIN_WINDOW_HOURS=24
SHADOW_MIN_COMPARISONS=100
GO09_CHECKPOINT_COMPLETE=false
DISCORD_LIVE_CHECKPOINT_COMPLETE=false
